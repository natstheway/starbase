# Bitsight Integration Configuration
# Copy this file to .env and fill in your values

# Required: Your Bitsight API key
BITSIGHT_API_KEY=your-api-key-here

# Optional: Specific company GUID to monitor (defaults to your primary company)
BITSIGHT_COMPANY_GUID=

# Optional: Include subsidiaries in data collection (true/false)
BITSIGHT_INCLUDE_SUBSIDIARIES=true

# Optional: Include historical findings data (true/false)
BITSIGHT_INCLUDE_FINDINGS_HISTORY=false
