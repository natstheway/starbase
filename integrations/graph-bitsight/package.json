{
  "name": "@jupiterone/graph-bitsight",
  "version": "1.0.0",
  "description": "JupiterOne integration for Bitsight security ratings and external attack surface data",
  "license": "MPL-2.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/JupiterOne/graph-bitsight"
  },
  "scripts": {
    "start": "j1-integration collect",
    "graph": "j1-integration visualize",
    "graph:types": "j1-integration visualize-types",
    "graph:spec": "j1-integration visualize-types --project-path docs/spec",
    "validate:questions": "j1-integration validate-question-file -f docs/jupiterone/questions/questions.yaml",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write '**/*.{ts,js,json,md}'",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:env": "LOAD_ENV=1 yarn test",
    "test:ci": "yarn lint && yarn type-check && yarn test",
    "build": "tsc -p tsconfig.dist.json --declaration && cp README.md dist/README.md && cp -r jupiterone/ dist/jupiterone/",
    "prepublishOnly": "yarn build"
  },
  "dependencies": {
    "@jupiterone/integration-sdk-cli": "^12.0.0",
    "@jupiterone/integration-sdk-core": "^12.0.0",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@jupiterone/integration-sdk-dev-tools": "^12.0.0",
    "@jupiterone/integration-sdk-testing": "^12.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/node-fetch": "^2.6.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "@jupiterone/integration-sdk-cli": "^12.0.0",
    "@jupiterone/integration-sdk-core": "^12.0.0"
  }
}
