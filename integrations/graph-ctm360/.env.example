# CTM360 Integration Configuration
# Copy this file to .env and fill in your values

# Required: Your CTM360 API key
CTM360_API_KEY=your-api-key-here

# Optional: CTM360 API URL (defaults to https://api.ctm360.com/v1)
CTM360_API_URL=

# Optional: Tenant ID for multi-tenant environments
CTM360_TENANT_ID=

# Optional: Include threat intelligence data (true/false, defaults to true)
CTM360_INCLUDE_THREATS=true

# Optional: Include data leak detection (true/false, defaults to true)
CTM360_INCLUDE_DATA_LEAKS=true

# Optional: Include brand abuse monitoring (true/false, defaults to true)
CTM360_INCLUDE_BRAND_ABUSE=true
