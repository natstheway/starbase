# Generic EASM Scanner Integration Configuration
# Copy this file to .env and fill in your values

# Required: Name of your scanner (used for entity identification)
EASM_SCANNER_NAME=custom-scanner

# Required: Data source type - 'file' or 'api'
EASM_SCANNER_DATA_SOURCE_TYPE=file

# For file-based data source:
# Path to JSON or CSV file containing scan results
EASM_SCANNER_DATA_FILE_PATH=./scan-results.json

# For API-based data source:
# URL of the API endpoint that returns scan results
EASM_SCANNER_API_URL=

# Optional: API key for authentication
EASM_SCANNER_API_KEY=

# Optional: Custom header name for API authentication (defaults to 'Authorization')
EASM_SCANNER_API_AUTH_HEADER=
