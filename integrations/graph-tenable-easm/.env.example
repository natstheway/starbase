# Tenable EASM Integration Configuration
# Copy this file to .env and fill in your values

# Required: Tenable API access key
TENABLE_EASM_ACCESS_KEY=your-access-key-here

# Required: Tenable API secret key
TENABLE_EASM_SECRET_KEY=your-secret-key-here

# Optional: Region (us, eu, etc. - defaults to us)
TENABLE_EASM_REGION=us

# Optional: Specific inventory ID to collect (collects all if not specified)
TENABLE_EASM_INVENTORY_ID=

# Optional: Include technology stack detection (true/false, defaults to true)
TENABLE_EASM_INCLUDE_TECHNOLOGIES=true

# Optional: Include web application discovery (true/false, defaults to true)
TENABLE_EASM_INCLUDE_WEB_APPS=true
